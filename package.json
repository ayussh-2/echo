{
  "name": "echo-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean",
    "generate-icons": "node apps/desktop/node_modules/electron/cli.js scripts/generate-icons.cjs"
  },
  "devDependencies": {
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "eslint": "^9.20.1",
    "turbo": "^2.4.4",
    "typescript": "^5.7.3"
  }
}
