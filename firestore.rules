rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper to check if caller is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper to check if caller owns the target user path
    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // All user-scoped collections (notifications, replies, devices, whitelist, pairing)
    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /{allSubcollections=**} {
        allow read, write: if isOwner(uid);
      }
    }

    // Short-lived pairing sessions (First-run QR code pairing)
    match /pending-pairing/{pairingId} {
      allow read, write: if isAuthenticated();
    }
  }
}
